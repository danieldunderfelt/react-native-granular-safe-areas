{
  "name": "react-native-granular-safe-areas",
  "version": "0.1.0",
  "description": "Granular safe areas for React Native: avoid the actual OS UI regions (iPhone Duo status column, cameras, system bars), not whole inset bands",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-granular-safe-areas-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "pnpm --filter react-native-granular-safe-areas-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "ios",
    "safe-area",
    "safe-area-insets",
    "iphone-duo",
    "reserved-regions",
    "status-bar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieldunderfelt/react-native-granular-safe-areas.git"
  },
  "author": "Daniel Dunderfelt (https://github.com/danieldunderfelt)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danieldunderfelt/react-native-granular-safe-areas/issues"
  },
  "homepage": "https://github.com/danieldunderfelt/react-native-granular-safe-areas#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-safe-area-context": "5.11.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.82.0",
    "react-native-safe-area-context": ">=5.11.0"
  },
  "packageManager": "pnpm@12.21.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "GranularSafeAreasSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "ios": {
      "components": {
        "GranularSafeAreaProviderView": {
          "className": "GSAProviderView"
        }
      },
      "modulesProvider": {
        "GranularSafeAreas": "GSAModule"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest"
    ],
    "version": "0.64.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ]
  }
}
